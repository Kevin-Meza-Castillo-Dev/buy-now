{
  "info": {
    "name": "Buy Now: catálogo e inventario",
    "description": "Peticiones del servicio catalogo-inventario. La variable `url` apunta al servicio; por defecto, al que corre en local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "url", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "Catálogo",
      "item": [
        {
          "name": "Categorías",
          "request": {
            "method": "GET",
            "description": "Todas las categorías, en su orden de aparición.",
            "url": { "raw": "{{url}}/categorias", "host": ["{{url}}"], "path": ["categorias"] }
          }
        },
        {
          "name": "Productos, primera página",
          "request": {
            "method": "GET",
            "description": "Una página de 20 productos activos, por el orden de su categoría y después por nombre.",
            "url": {
              "raw": "{{url}}/productos?pagina=1",
              "host": ["{{url}}"],
              "path": ["productos"],
              "query": [
                { "key": "pagina", "value": "1", "description": "Número de página, desde 1." }
              ]
            }
          }
        },
        {
          "name": "Productos, búsqueda por nombre",
          "request": {
            "method": "GET",
            "description": "Los productos con ese texto en el nombre. No distingue mayúsculas ni tildes: `limon` encuentra `Limón`.",
            "url": {
              "raw": "{{url}}/productos?buscar=limon",
              "host": ["{{url}}"],
              "path": ["productos"],
              "query": [
                { "key": "buscar", "value": "limon", "description": "Hasta 60 caracteres." }
              ]
            }
          }
        },
        {
          "name": "Productos, por categoría",
          "request": {
            "method": "GET",
            "description": "Los productos de una categoría.",
            "url": {
              "raw": "{{url}}/productos?categoria=1",
              "host": ["{{url}}"],
              "path": ["productos"],
              "query": [
                {
                  "key": "categoria",
                  "value": "1",
                  "description": "Id de la categoría, de `GET /categorias`."
                }
              ]
            }
          }
        },
        {
          "name": "Productos, búsqueda dentro de una categoría",
          "request": {
            "method": "GET",
            "description": "Los productos que cumplen las dos condiciones.",
            "url": {
              "raw": "{{url}}/productos?buscar=limon&categoria=1&pagina=1",
              "host": ["{{url}}"],
              "path": ["productos"],
              "query": [
                { "key": "buscar", "value": "limon" },
                { "key": "categoria", "value": "1" },
                { "key": "pagina", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Producto, detalle",
          "request": {
            "method": "GET",
            "description": "Un producto activo con su descripción, su categoría y sus unidades disponibles. Si no existe o no está activo, responde 404 `producto_no_encontrado`.",
            "url": {
              "raw": "{{url}}/productos/:id",
              "host": ["{{url}}"],
              "path": ["productos", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Id del producto. Toma uno de la lista de productos."
                }
              ]
            }
          }
        },
        {
          "name": "Productos, página no válida (422)",
          "request": {
            "method": "GET",
            "description": "Responde 422 `datos_invalidos` con el campo que falló.",
            "url": {
              "raw": "{{url}}/productos?pagina=0",
              "host": ["{{url}}"],
              "path": ["productos"],
              "query": [{ "key": "pagina", "value": "0" }]
            }
          }
        }
      ]
    },
    {
      "name": "Stock",
      "item": [
        {
          "name": "Stock visible de varios productos",
          "request": {
            "method": "GET",
            "description": "Las unidades disponibles de 1 a 50 productos. La respuesta se puede guardar en caché 5 segundos. Un id que no es de ningún producto no aparece.",
            "url": {
              "raw": "{{url}}/stock?ids=1,2,3",
              "host": ["{{url}}"],
              "path": ["stock"],
              "query": [
                {
                  "key": "ids",
                  "value": "1,2,3",
                  "description": "Ids de producto separados por coma. Toma algunos de la lista de productos."
                }
              ]
            }
          }
        },
        {
          "name": "Stock, ids no válidos (422)",
          "request": {
            "method": "GET",
            "description": "Responde 422 `datos_invalidos` con el campo `ids`.",
            "url": {
              "raw": "{{url}}/stock?ids=1,abc",
              "host": ["{{url}}"],
              "path": ["stock"],
              "query": [{ "key": "ids", "value": "1,abc" }]
            }
          }
        }
      ]
    },
    {
      "name": "Fotos",
      "item": [
        {
          "name": "Foto de un producto",
          "request": {
            "method": "GET",
            "description": "La imagen en WebP de 480 × 480. La ruta viene en `foto_url`.",
            "url": {
              "raw": "{{url}}/fotos/:archivo",
              "host": ["{{url}}"],
              "path": ["fotos", ":archivo"],
              "variable": [{ "key": "archivo", "value": "limon.webp" }]
            }
          }
        }
      ]
    }
  ]
}
